# Copy to .env for local development. Never commit .env.
DATABASE_URL=mysql://badcam:change-me@127.0.0.1:3307/badcam
# At least 12 characters. This is the one password for the web viewer.
OWNER_PASSWORD=change-me-please-12
# At least 32 characters. Signs the session cookie: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
DATA_DIR=./data
RETAIN_SENTRY_DAYS=90
RETAIN_SAVED_DAYS=0
RETAIN_RECENT_DAYS=7
RETAIN_ORIGINALS_DAYS=14
MIN_FREE_GB=5
STITCH_FPS=24
STITCH_CRF=26
STITCH_MIRROR=none
HIGHLIGHT=false
# Email (all optional). Without SMTP_HOST (here or on the Settings page) no mail
# is sent in production; in development mail goes to Mailpit on localhost:1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Badcam <badcam@example.com>
SMTP_REPLY_TO=
# Default recipients, comma-separated (editable on the Settings page).
NOTIFY_TO=owner@example.com
# Base URL for links in mail, without a trailing slash.
PUBLIC_URL=http://localhost:3100
# Seals the SMTP password stored in the database: openssl rand -base64 32
SETTINGS_SECRET_KEY=
# Only for docker-compose.local.yaml (the bundled MySQL):
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
