[Unit]
Description=badcam: write Wi-Fi connections from badcam.toml
Before=NetworkManager.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/badcam
Environment=PYTHONPATH=/opt/badcam
ExecStart=/usr/bin/python3 -m badcam wifi-apply

[Install]
WantedBy=multi-user.target
RequiredBy=NetworkManager.service
